<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view_id"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        app:show_fastforward_button="false"
        app:show_next_button="false"
        app:show_previous_button="false"
        app:show_rewind_button="false"
        app:show_shuffle_button="false">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#E0000000"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Source HLS Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#2D2D2D"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="4dp"
                    android:elevation="4dp">

                    <TextView
                        android:id="@+id/label_source_hls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📺 Source Stream"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/source_hls"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/spinner_background"
                        android:popupBackground="#FFFFFF"
                        android:paddingHorizontal="12dp" />

                </LinearLayout>

                <!-- Ads Endpoint Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#2D2D2D"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="4dp"
                    android:elevation="4dp">

                    <TextView
                        android:id="@+id/label_ads_endpoint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 Ads Endpoint"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/ads_endpoint"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:hint="Enter Ads Endpoint"
                        android:inputType="text"
                        android:background="@drawable/edit_text_background"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp" />

                </LinearLayout>

                <!-- Button Section -->
                <Button
                    android:id="@+id/reload_player"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🔄 Update and Reload"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_background"
                    android:elevation="6dp"
                    android:layout_marginBottom="6dp" />

            </LinearLayout>

        </ScrollView>

    </androidx.media3.ui.PlayerView>

</LinearLayout>